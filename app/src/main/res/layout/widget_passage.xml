<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件版式（v3「留白」）

  设计取向：版面交给正文，配角一律降级为脚注。
  · 全卡只有一处彩色：左上角 26dp 红色短线，作为正文的「起笔」
  · 正文是本卡唯一主角 —— 垂直居中、行距 1.75、占版面 80% 以上
  · 条目名 / 页码 / 「换一条」全部缩到 11sp，并排压在底部一行脚注里
  · 进度条已移除（它是最「工具化」的一笔，且与留白取向冲突）
  · 圆角 20dp、内边距 18dp 起步（实际值由 State.metrics 按真实尺寸下发）
  · 深色模式不需要单独的布局：values-night/colors.xml 覆盖同名颜色即可
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!--
      这里必须是 TextView（一个空的、只当色块用的 TextView），
      **不能写成 <View>** —— RemoteViews 只支持 FrameLayout / LinearLayout /
      RelativeLayout / GridLayout 四种布局，加上 TextView / ImageView / Button /
      ProgressBar 等固定控件；原生 View 和自定义 View 都不支持，
      桌面在渲染时会抛 InflateException，小部件框里就显示成
      「载入窗口小部件时出现问题」。
      （历史事故：v2/v3 这里误用了 <View>，v1 用 TextView 是正常的。）
    -->
    <TextView
        android:layout_width="26dp"
        android:layout_height="3dp"
        android:background="@drawable/accent_bar" />

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.75"
        android:maxLines="20"
        android:textColor="@color/body"
        android:textSize="14sp"
        tools:text="任何叙事都做了选择。它突出一些事实、忽略另一些事实，把先后写成因果。" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/foot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gray_light"
            android:textSize="11sp"
            tools:text="1.1　叙事" />

        <TextView
            android:id="@+id/pageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/gray_light"
            android:textSize="11sp"
            tools:text="2/3" />

        <TextView
            android:id="@+id/btn_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="0dp"
            android:paddingBottom="6dp"
            android:text="@string/change_short"
            android:textColor="@color/red"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
