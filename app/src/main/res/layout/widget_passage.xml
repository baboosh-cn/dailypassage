<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件版式（v4「满版」）

  设计取向：版面完全交给正文，配角一律降级为脚注。
  · 已删掉 v3 左上角那段 26dp 红色短线 —— 它只值 3dp，却打断了正文的起笔，
    删除后版面更完整。**全卡不再有任何装饰色块**，唯一彩色是脚注右侧的红字按钮。
  · 正文是本卡唯一主角 —— 垂直居中、行距 1.55（v3 为 1.75，收紧是为换出第 5 行）、
    占版面 80% 以上
  · 条目名 / 页码 / 「换一条」全部缩到 11sp 上下，并排压在底部一行脚注里；
    条目名不加标签底（灰鸽 2026-10-03 明确要求：底色只作用于卡片本身）
  · 圆角 20dp、内边距 14/18dp（实际值由 State.metrics 按真实尺寸下发）
  · 未使用任何 <View>：RemoteViews 不支持原生 View，详见下方说明
  · 深色模式不需要单独的布局：values-night/colors.xml 覆盖同名颜色即可
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
      布局里所有控件都必须是 RemoteViews 白名单内的类型：
      FrameLayout / LinearLayout / RelativeLayout / GridLayout 四种布局，
      加 TextView / ImageView / Button / ImageButton / ProgressBar 等固定控件。
      **原生 View 和自定义 View 一律不支持，连「只当色块用」的 <View> 也不行** ——
      桌面渲染时会抛 InflateException，小部件框里显示成
      「载入窗口小部件时出现问题」。（历史事故：v2/v3 左上角误用 <View>。）
      check_project.py 已加硬规则在提交前拦截，改动前先看那条规则。
    -->
    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.55"
        android:maxLines="20"
        android:textColor="@color/body"
        android:textSize="14sp"
        tools:text="任何叙事都做了选择。它突出一些事实、忽略另一些事实，把先后写成因果，把一个价值方向设为目标。" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/foot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gray_light"
            android:textSize="11sp"
            tools:text="1.1　叙事" />

        <TextView
            android:id="@+id/pageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/gray_light"
            android:textSize="11sp"
            tools:text="2/3" />

        <TextView
            android:id="@+id/btn_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="0dp"
            android:paddingBottom="4dp"
            android:text="@string/change_short"
            android:textColor="@color/red"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
